{
  "name": "dsh-hmos-sidebar",
  "version": "0.5.1",
  "description": "EN: Windows-only HarmonyOS workbench for DeepSeek Harness with 41 dcli tools and one native agent preset. ZH: 面向 DeepSeek Harness 的 Windows 原生鸿蒙开发工作台，包含 41 个 dcli 工具与一个原生鸿蒙预设。",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-hmos-sidebar": "bin/dsh-hmos-sidebar.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./tools": "./lib/dcli-tools.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.1.0-rc.7 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-plugins",
    "deepseek-harness",
    "harmonyos",
    "harmonyos-next",
    "deveco-studio",
    "arkts",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YrracOwl/dsh-hmos-sidebar.git",
    "directory": "packages/dsh-hmos-sidebar"
  },
  "homepage": "https://github.com/YrracOwl/dsh-hmos-sidebar#readme",
  "bugs": {
    "url": "https://github.com/YrracOwl/dsh-hmos-sidebar/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-0 || ^0.1.2-rc.1 || ^0.2.0-rc.1 || ^0.2.1-0",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "license": "MIT"
}
